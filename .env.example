# ---------- App
APP_NAME=kanji-practice
APP_ENV=dev

# ---------- Postgres
PG_HOST=localhost
PG_PORT=5432
PG_USER=user
PG_PASSWORD=user1234
PG_DATABASE=data-base-name
PG_SCHEMA=public
PG_SSL_MODE=disable

# ---------- Client
CLIENT_PORT=3000
VITE_API_URL=http://localhost:3001

# ---------- Server
SERVER_PORT=3001
CORS_ORIGINS=http://localhost:3000
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
JWT_SECRET=jwt-secret
# bcrypt hash (cost 12) ต้องครอบด้วย single quote ไม่งั้น docker compose จะตีความ $ เป็นตัวแปร
# สร้างด้วย: cd server && node -e 'require("bcryptjs").hash("dummy",12).then(console.log)'
DUMMY_PASSWORD_HASH='$2b$12$replace.with.your.own.bcrypt.hash.generated.above.xxxx'
